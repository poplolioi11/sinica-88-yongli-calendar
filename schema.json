{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sinica 88 text-only corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "stage",
    "offset_basis",
    "metadata",
    "sources",
    "pages",
    "excluded_units"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "version": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "initial",
        "ai-reviewed"
      ]
    },
    "offset_basis": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_url",
        "manifest_sha256",
        "coordinate_system",
        "canvases"
      ],
      "properties": {
        "manifest_url": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "coordinate_system": {
          "const": "actual-decoded-image-pixels"
        },
        "canvases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canvas_index",
              "canvas_id",
              "manifest_label",
              "image_uri",
              "image_sha256",
              "decoded_width",
              "decoded_height",
              "manifest_width",
              "manifest_height",
              "reading_regions"
            ],
            "properties": {
              "canvas_index": {
                "type": "integer",
                "minimum": 1
              },
              "canvas_id": {
                "type": "string"
              },
              "manifest_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "image_uri": {
                "type": "string"
              },
              "image_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "decoded_width": {
                "type": "integer",
                "minimum": 1
              },
              "decoded_height": {
                "type": "integer",
                "minimum": 1
              },
              "manifest_width": {
                "type": "integer",
                "minimum": 1
              },
              "manifest_height": {
                "type": "integer",
                "minimum": 1
              },
              "reading_regions": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "bbox"
                  ],
                  "properties": {
                    "id": {
                      "enum": [
                        "right",
                        "left"
                      ]
                    },
                    "bbox": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  }
                }
              }
            }
          },
          "minItems": 16,
          "maxItems": 16
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canvas_index",
          "kind",
          "printed_label",
          "units",
          "page_notes",
          "excluded_notes"
        ],
        "properties": {
          "canvas_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "kind": {
            "type": "string"
          },
          "printed_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "region",
                "order",
                "role",
                "column_label",
                "text",
                "uncertainties"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^p[0-9]{2}-u[0-9]{3,}$"
                },
                "region": {
                  "enum": [
                    "right",
                    "left",
                    "whole"
                  ]
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "role": {
                  "enum": [
                    "body",
                    "heading",
                    "table",
                    "diagram-label",
                    "caption",
                    "paratext"
                  ]
                },
                "column_label": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "uncertainties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "offset",
                      "length",
                      "candidates",
                      "reason",
                      "status",
                      "missing_extent"
                    ],
                    "properties": {
                      "offset": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "length": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "candidates": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "const": "unresolved"
                      },
                      "missing_extent": {
                        "oneOf": [
                          {
                            "const": "unknown"
                          },
                          {
                            "type": "integer",
                            "minimum": 1
                          }
                        ]
                      }
                    }
                  }
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "bbox_granularity": {
                  "enum": [
                    "half-page",
                    "whole-page",
                    "supplied-region-not-character-level"
                  ]
                }
              }
            }
          },
          "page_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excluded_notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canvas_index",
                "unit_id",
                "region",
                "order",
                "location",
                "description",
                "status"
              ],
              "properties": {
                "canvas_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit_id": {
                  "type": "string"
                },
                "region": {
                  "enum": [
                    "right",
                    "left",
                    "whole"
                  ]
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "location": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "const": "rights-unresolved"
                }
              }
            }
          }
        }
      },
      "minItems": 16,
      "maxItems": 16
    },
    "excluded_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canvas_index",
          "unit_id",
          "region",
          "order",
          "location",
          "description",
          "status"
        ],
        "properties": {
          "canvas_index": {
            "type": "integer",
            "minimum": 1
          },
          "unit_id": {
            "type": "string"
          },
          "region": {
            "enum": [
              "right",
              "left",
              "whole"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "const": "rights-unresolved"
          }
        }
      }
    }
  }
}
